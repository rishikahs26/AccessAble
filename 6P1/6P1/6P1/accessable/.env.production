# Frontend production environment variables
# In production the React app is served by the Express backend at the same origin,
# so API calls to /api/* route correctly without needing an absolute URL.
# This file is intentionally minimal – do NOT put secrets here (it ships in the build).

# Tells Create React App this is a production build
NODE_ENV=production

# Suppress source map generation (also hides missing-sourcemap warnings from
# third-party packages like @mediapipe/tasks-vision)
GENERATE_SOURCEMAP=false
